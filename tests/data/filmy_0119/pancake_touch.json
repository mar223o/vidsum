"pl": [
{
"start": 0.0,
"end": 0.52,
"text": "Płatki."
},
{
"start": 3.3,
"end": 4.3,
"text": "Twój stop był za wysoko."
},
{
"start": 4.42,
"end": 4.62,
"text": "Spróbuj jeszcze raz."
},
{
"start": 7.9,
"end": 9.04,
"text": "Trzymaj stop bro."
},
{
"start": 9.42,
"end": 10.08,
"text": "Trzymaj stop."
},
{
"start": 10.3,
"end": 11.46,
"text": "Więc tworzysz płaską powierzchnię."
},
{
"start": 11.66,
"end": 12.62,
"text": "Więc odbija się w górę."
},
{
"start": 17.4,
"end": 18.68,
"text": "Nie chcesz podnosić palców stóp."
},
{
"start": 18.8,
"end": 19.72,
"text": "Ponieważ, jeśli uderzy..."
},
{
"start": 19.98,
"end": 21.26,
"text": "To po prostu odskoczy do przodu."
},
{
"start": 21.54,
"end": 22.66,
"text": "I stracisz kontrolę nad piłką."
},
{
"start": 22.9,
"end": 24.08,
"text": "Chcesz trzymać stop."
},
{
"start": 24.95,
"end": 25.63,
"text": "Palce w dół."
},
{
"start": 26.35,
"end": 26.45,
"text": "Więc."
},
{
"start": 26.93,
"end": 28.13,
"text": "Więc, kiedy uderzy..."
},
{
"start": 28.37,
"end": 29.77,
"text": "To po prostu odbija się prosto do góry."
},
{
"start": 29.87,
"end": 30.51,
"text": "I możesz zrobić krok."
},
{
"start": 30.75,
"end": 31.27,
"text": "Do zabawy."
},
{
"start": 31.45,
"end": 32.41,
"text": "Kiedy dokonujesz kontaktu."
},
{
"start": 32.55,
"end": 33.09,
"text": "Chcesz podnieść."
},
{
"start": 33.27,
"end": 34.11,
"text": "Tylna noga."
},
{
"start": 34.43,
"end": 35.53,
"text": "Chcesz stanąć na palcach?"
},
{
"start": 36.07,
"end": 36.83,
"text": "Więc jedziesz."
},
{
"start": 36.87,
"end": 37.55,
"text": "Twój impet."
},
{
"start": 38.14,
"end": 38.84,
"text": "Naprzód."
},
{
"start": 39.06,
"end": 40.14,
"text": "Wtedy, kiedy to odbije w górę."
},
{
"start": 40.28,
"end": 41.56,
"text": "Możesz wejść do gry zręcznościowej."
},
{
"start": 41.82,
"end": 42.3,
"text": "Trzymaj się tego."
},
{
"start": 43.54,
"end": 43.94,
"text": "Naprzód."
},
{
"start": 44.48,
"end": 44.6,
"text": "Boom."
},
{
"start": 44.9,
"end": 46.0,
"text": "Wejdź do gry zręcznościowej."
},
{
"start": 46.7,
"end": 47.0,
"text": "Trzymaj się tego."
},
{
"start": 51.39,
"end": 51.97,
"text": "Dobra robota."
},
{
"start": 53.33,
"end": 53.77,
"text": "Zrób to."
},
{
"start": 53.89,
"end": 54.73,
"text": "Wychodź z gry zręcznościowej teraz."
},
{
"start": 54.91,
"end": 55.45,
"text": "Nie w górę."
},
{
"start": 55.71,
"end": 56.49,
"text": "Nie za daleko w górę."
},
{
"start": 58.21,
"end": 58.77,
"text": "Dobra robota."
},
{
"start": 58.99,
"end": 59.39,
"text": "Po prostu tak."
},
{
