 "segmenty": [
  {
   "start": 0.0,
   "end": 0.54,
   "text": "This is it."
  },
  {
   "start": 1.09,
   "end": 2.63,
   "text": "This is the perfect French fry."
  },
  {
   "start": 2.81,
   "end": 4.57,
   "text": "The secret to super crispy fries."
  },
  {
   "start": 4.77,
   "end": 5.81,
   "text": "Start with agria potatoes."
  },
  {
   "start": 6.13,
   "end": 7.53,
   "text": "This particular potato variety."
  },
  {
   "start": 7.75,
   "end": 9.49,
   "text": "Is a very high starch content."
  },
  {
   "start": 9.71,
   "end": 10.87,
   "text": "And a very low water content."
  },
  {
   "start": 11.09,
   "end": 12.35,
   "text": "Perfect for crispiness."
  },
  {
   "start": 12.57,
   "end": 12.85,
   "text": "Peel."
  },
  {
   "start": 12.97,
   "end": 13.91,
   "text": "Trim the ends and sides."
  },
  {
   "start": 14.05,
   "end": 15.17,
   "text": "And cut them off lengthways."
  },
  {
   "start": 15.39,
   "end": 16.19,
   "text": "Into uniform fries."
  },
  {
   "start": 16.47,
   "end": 17.79,
   "text": "Roughly one centimetre square."
  },
  {
   "start": 18.13,
   "end": 19.11,
   "text": "Soak them in cold water."
  },
  {
   "start": 19.23,
   "end": 20.49,
   "text": "To remove any excess starch."
  },
  {
   "start": 20.71,
   "end": 21.89,
   "text": "And wash them a few times."
  },
  {
   "start": 22.05,
   "end": 23.63,
   "text": "Until the water runs perfectly clear."
  },
  {
   "start": 23.79,
   "end": 24.93,
   "text": "Bring a pot of water to the boil."
  },
  {
   "start": 25.05,
   "end": 25.85,
   "text": "Add baking soda."
  },
  {
   "start": 26.11,
   "end": 27.79,
   "text": "Which is going to help them to fluff and break down."
  },
  {
   "start": 27.91,
   "end": 28.31,
   "text": "And salt."
  },
  {
   "start": 28.43,
   "end": 29.19,
   "text": "Which is going to season them."
  },
  {
   "start": 29.33,
   "end": 30.55,
   "text": "Then boil the fries until just."
  },
  {
   "start": 30.63,
   "end": 30.89,
   "text": "Tender."
  },
  {
   "start": 31.07,
   "end": 32.01,
   "text": "They should break without snapping."
  },
  {
   "start": 32.23,
   "end": 33.93,
   "text": "Drain just lightly with potato starch."
  },
  {
   "start": 34.13,
   "end": 35.73,
   "text": "This is going to add a beautiful crispy layer."
  },
  {
   "start": 35.93,
   "end": 37.69,
   "text": "And then place them into the fridge or freezer."
  },
  {
   "start": 37.89,
   "end": 38.71,
   "text": "To completely cool."
  },
  {
   "start": 38.89,
   "end": 39.67,
   "text": "Heat oil in a pot."
  },
  {
   "start": 39.81,
   "end": 41.21,
   "text": "We've got some duck fat too for flavour."
  },
  {
   "start": 41.39,
   "end": 43.67,
   "text": "And once it reaches around about 140 degrees."
  },
  {
   "start": 44.01,
   "end": 45.03,
   "text": "We're going to drop in our fries."
  },
  {
   "start": 45.17,
   "end": 46.01,
   "text": "And par-fry them."
  },
  {
   "start": 46.21,
   "end": 46.69,
   "text": "Or blanch them."
  },
  {
   "start": 46.91,
   "end": 48.33,
   "text": "Steering constantly for ruffled edges."
  },
  {
   "start": 48.55,
   "end": 49.03,
   "text": "Remove them."
  },
  {
   "start": 49.17,
   "end": 49.81,
   "text": "Lay them in a tray."
  },
  {
   "start": 50.03,
   "end": 51.07,
   "text": "And freeze or chill again."
  },
  {
   "start": 51.31,
   "end": 52.03,
   "text": "For the final fry."
  },
  {
   "start": 52.11,
   "end": 53.01,
   "text": "Heat the oil up to 190."
  },
  {
   "start": 53.41,
   "end": 54.63,
   "text": "Fry until golden and crispy."
  },
  {
   "start": 54.85,
   "end": 56.19,
   "text": "Finish with a sprinkle of maldon chocolate."
  },
  {
   "start": 56.19,
   "end": 57.03,
   "text": "Extra crunch."
  }
 ],
